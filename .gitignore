# ===== Go =====
# go.sum is committed on purpose: CI builds ./server with `go build`, and a
# missing checksum file aborts the build ("missing go.sum entry"). Keep the
# pinned dependency hashes in the repository instead of ignoring them.

# ===== Native Libraries (compiled) =====
*.so
*.dll
*.dylib
jniLibs/
app/src/main/jniLibs/

# ===== CSQTT engine (built from pinned upstream tag) =====
build/csqtt-engine/
app/src/main/jniLibs/*/libcsqtt.so
app/src/main/assets/csqtt-engine.json

# ===== Server binary =====
app/src/main/assets/server

